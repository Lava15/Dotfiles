{
  "custom-ui-style.stylesheet": {
    "[Aura Dracula Spirit (Soft)]": {
      "editorSuggestWidget.selectionHighlight": "#3A334B",
      "editorSuggestWidget.background": "#000",
    },
    // "editorSuggestWidget.border": "1px solid #00BFFF",
    // "editorSuggestWidget.foreground": "#00BFFF",
    // "editorSuggestWidget.highlightForeground": "#00BFFF",
    // "editorSuggestWidget.selectedBackground": "#00BFFF",
    ".part.sidebar": "box-shadow: 0px 0px 50px rgba(0, 0, 0, .25)",
    ".composite.title": "display: flex !important; flex-direction: row !important; align-items: center !important; justify-items: center !important",
    ".composite.title h2": "font-weight: bold !important; font-size: 12px !important; text-transform: uppercase; color: #00BFFF !important;",
    ".composite.title h2::before": "display: inline-block; margin-right: 6px; font-size: 1.1rem; content: '🚜';",
    ".monaco-scrollable-element>.shadow.top": "box-shadow: 0px 0px 10px rgba(0,0,0,.75) !important; top: -3px !important",
    ".monaco-workbench .part.titlebar>.titlebar-container>.titlebar-center>.window-title>.command-center .action-item.command-center-center": "border: none !important; background: transparent !important;",
    ".search-label": "font-size: 14px !important; color: #00BFFF; display: block;",
    ".titlebar-container": "background-color: #2c2a30 !important",
    ".search-icon": "display: none !important;",
    ".codicon-search::before": "display: none !important;",
    ".codicon-arrow-right, .codicon-arrow-left": "display: none !important;",
    ".monaco-list-rows": "background: transparent !important;",
    ".monaco-list-row:hover": "background: rgba(0, 0, 0, .2) !important;",
    ".quick-input-filter .monaco-inputbox": "border-radius: 12px !important; padding: 8px !important; border: none !important; font-size: 14px !important; margin-bottom: 16px !important;",
    "#command-blur": "position: absolute; width: 100%; height: 100%; background: rgba(0, 0, 0, .15); top: 0; left: 0; backdrop-filter: blur(8px);",
    ".monaco-list-row.focused": "background-color: #33658A !important;",
    ".synthetic-focus": "outline-color: rgba(50, 50, 50, 1) !important;",
    ".monaco-inputbox input::placeholder": "color: rgba(255, 255, 255, .3) !important;",
    // DARK THEME 
    ".cursor": "background: linear-gradient(to bottom, #00BFFF, #33658A, #00BFFF); height: 50px !important;",
    ".quick-input-widget": "background: linear-gradient(to top, #30cfd0 0%, #330867 100%); border-radius: 5px; border: none; margin-top: 15%; padding: 10px 10px 18px 10px !important;",
    // WHITE THEME 
    // ".cursor": "background-image: linear-gradient(to top, #5ee7df 0%, #b490ca 100%);",
    // ".quick-input-widget": "background-image: linear-gradient(45deg, #93a5cf 0%, #e4efe9 100%); border-radius: 5px; border: none; margin-top: 15%",
  },
  "files.associations": {
    "*.tmpl": "html"
  },
  "editor.formatOnSave": false,
  "editor.copyWithSyntaxHighlighting": false,
  "editor.snippetSuggestions": "top",
  "explorer.confirmDelete": false,
  "editor.fontSize": 16,
  "workbench.colorCustomizations": {
    // "editorSuggestWidget.background": "#252425",
    // "sideBar.background": "#252425", 
    // "editor.background": "#252425",
    "list.inactiveSelectionBackground": "#00fffb29",
    "list.focusBackground": "#00fffb29",
    "list.hoverBackground": "#00fffb29",
    "editorCursor.background": "#ffe206",
  },
  "intelephense.maxMemory": 3000000,
