{
  "files.associations": {
    "*.tmpl": "html"
  },
  "editor.formatOnSave": false,
  "editor.copyWithSyntaxHighlighting": false,
  "editor.snippetSuggestions": "top",
  "explorer.confirmDelete": false,
  "editor.fontSize": 16,
  "workbench.colorCustomizations": {
    // "editorSuggestWidget.background": "#252425",
    // "sideBar.background": "#252425", 
    // "editor.background": "#252425",
    "list.inactiveSelectionBackground": "#00fffb29",
    "list.focusBackground": "#00fffb29", 
    "list.hoverBackground": "#00fffb29"
  },
  "intelephense.maxMemory": 3000000,
  "intelephense.stubs": [
    "apache",
    "bcmath",
    "bz2",
    "calendar",
    "com_dotnet",
    "Core",
    "ctype",
    "curl",
    "date",
    "dba",
    "dom",
    "enchant",
    "exif",
    "FFI",
    "fileinfo",
    "filter",
    "fpm",
    "ftp",
    "gd",
    "gettext",
    "gmp",
    "hash",
    "iconv",
    "imap",
    "intl",
    "json",
    "ldap",
    "libxml",
    "mbstring",
    "meta",
    "mysqli",
    "oci8",
    "odbc",
    "openssl",
    "pcntl",
    "pcre",
    "PDO",
    "pdo_ibm",
    "pdo_mysql",
    "pdo_pgsql",
    "pdo_sqlite",
    "pgsql",
    "Phar",
    "posix",
    "pspell",
    "readline",
    "Reflection",
    "session",
    "shmop",
    "SimpleXML",
    "snmp",
    "soap",
    "sockets",
    "sodium",
    "SPL",
    "sqlite3",
    "standard",
    "superglobals",
    "sysvmsg",
    "sysvsem",
    "sysvshm",
    "tidy",
    "tokenizer",
      "xml",
      "xmlreader",
      "xmlrpc",
      "xmlwriter",
      "xsl",
      "Zend OPcache",
      "zip",
      "zlib",
      "wordpress"
    ],
    "javascript.updateImportsOnFileMove.enabled": "always",
    "go.toolsManagement.autoUpdate": true,
    "go.useLanguageServer": false,
    "extensions.experimental.affinity": {
      "asvetliakov.vscode-neovim": 1
    },
    "workbench.tree.renderIndentGuides": "none",
    "workbench.editor.showTabs": "single",
    "window.zoomLevel": 2,
    "workbench.startupEditor": "none",
    "workbench.tips.enabled": false,
    "editor.guides.indentation": false,
    "editor.renderWhitespace": "none",
    "editor.renderLineHighlight": "none",
    "editor.lightbulb.enabled": "off",
    "editor.hover.enabled": false,
    "editor.showFoldingControls": "never",
    "editor.scrollbar.horizontal": "hidden",
    "editor.overviewRulerBorder": false,
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.lineHeight": 50,
    "explorer.compactFolders": false,
    "git.decorations.enabled": false,
    "scm.diffDecorations": "none",
    "files.insertFinalNewline": true,
    "extensions.ignoreRecommendations": true,
    "editor.cursorWidth": 3,
    "terminal.integrated.cursorStyle": "line",
    "editor.minimap.enabled": false,
    "[php]": {
      "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
    },
    "files.autoSave": "off",
    "editor.unicodeHighlight.nonBasicASCII": false,
    "terminal.integrated.fontFamily": "MesloLGS NF",
    "[go]": {
      "editor.defaultFormatter": "golang.go"
    },
    "php.suggest.basic": false,
    "[blade]": {
      "editor.defaultFormatter": "shufo.vscode-blade-formatter"
    },
    "terminal.integrated.lineHeight": 2,
    "window.menuBarVisibility": "toggle",
    "workbench.sideBar.location": "right",
    "workbench.statusBar.visible": false,
    "workbench.activityBar.location": "bottom",
    "editor.semanticHighlighting.enabled": false,
    "window.customTitleBarVisibility": "auto",
    "editor.stickyScroll.enabled": false,
    "workbench.iconTheme": "material-icon-theme",
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.tabs.enabled": false,
    "workbench.colorTheme": "Winter is Coming (Light)",
    "codeium.enableConfig": {
      "*": true
    },
    "workbench.layoutControl.enabled": false,
    "editor.tabSize": 2,
  }
